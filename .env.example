# Copy to apps/web/.env.local (local dev) or set in your hosting provider. NEVER commit real values.

# From `npx supabase status` (local) or Supabase Dashboard > Project Settings > API (hosted)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# SERVER ONLY. Used solely to create staff logins. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only for scripts/maintenance/backup.sh (direct Postgres connection string)
# DATABASE_URL=postgresql://postgres:***@db.<project>.supabase.co:5432/postgres
